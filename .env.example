# Copiá este archivo a ".env" y completá tus datos.
# El archivo .env NO se sube a git (está en .gitignore).

# --- Garmin Connect ---
# Opcional: si los dejás vacíos, podés loguearte desde la interfaz web.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Carpeta donde se guarda la sesión de Garmin (para no loguear cada vez)
GARMIN_TOKEN_DIR=.garmin_tokens

# --- Base de datos ---
DB_PATH=coach.db

# --- Openrouteservice (rutas) - Fase 5 ---
# Conseguí una API key gratuita en https://openrouteservice.org/dev/#/signup
ORS_API_KEY=TU_API_KEY_DE_OPENROUTESERVICE_AQUI

# --- OpenWeather (clima) - Fase 2 opcional ---
# API key gratuita en https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=TU_API_KEY_DE_OPENWEATHER_AQUI

# --- Sincronización automática ---
# Cada cuántas horas sincronizar solo (con el servidor corriendo). 24 = una vez al día.
SYNC_INTERVAL_HOURS=24
